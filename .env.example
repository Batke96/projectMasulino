# Local development defaults. Replace every value in Vercel project settings
# before any shared or production deployment. These are not production secrets.

# App runtime role: no superuser, no BYPASSRLS. Pooled Neon URL in deployment.
DATABASE_URL=postgresql://masulino_app:masulino_app_local@127.0.0.1:54329/masulino

# Better Auth role: identity schema only.
DATABASE_URL_AUTH=postgresql://masulino_auth:masulino_auth_local@127.0.0.1:54329/masulino

# Outbox drain role. Cron only.
DATABASE_URL_WORKER=postgresql://masulino_worker:masulino_worker_local@127.0.0.1:54329/masulino

# Migration/bootstrap role. Never configure this on the Next.js runtime.
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@127.0.0.1:54329/masulino

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=replace-with-random-cron-secret

# Local seed refuses to run when NODE_ENV=production.
# Synthetic password is defined only in the seed script, not in the app.
MASULINO_SEED_CONFIRM=synthetic
